# Copy to .env and fill in the values. .env is git-ignored.

# Google Maps Platform keys (design/data-sources/google.md, section 1).
# The server key is restricted to Routes, Places (New), and Weather.
GOOGLE_MAPS_SERVER_KEY=
# The browser key is restricted to the Maps JavaScript API and the app's addresses.
# Vite builds it into the front end. The web image gets it from a GitHub repo variable
# of the same name (systems design section 7).
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Supabase Auth (systems design section 3). The app reads SUPABASE_URL to check sign-in
# tokens. The front end gets the same address, and the project's publishable key, from
# the VITE_ variables, which are also GitHub repo variables. Of the three, only
# SUPABASE_URL goes in the server's .env.
SUPABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Claude Code's own Supabase user, so it can sign in to the deployed app and use the
# agents the way a user does (DEVELOPMENT.md section 5). It's an ordinary user, kept apart
# from Joe's so its trips and memory don't mix with his. Only on this machine: never in
# the server's .env, and never with a VITE_ prefix, which would build the password into
# the front end. Put the password in single quotes, so characters such as # and $ are
# read as they are. It can't hold a single quote itself.
SUPABASE_CLAUDE_EMAIL=
SUPABASE_CLAUDE_PASSWORD=

# The Claude Max plan's token, for the Agent SDK (systems design section 8). Make it
# with claude setup-token. It lasts a year. Don't set ANTHROPIC_API_KEY: the app leaves it
# out, since it would bill an API account instead of the plan.
CLAUDE_CODE_OAUTH_TOKEN=

# The address the app listens on. 127.0.0.1 for npm run dev. Docker Compose sets 0.0.0.0
# inside the app container.
APP_HOST=

# Postgres (systems design section 2). The postgres container makes the user and the
# database from these the first time it starts, so changing the password later
# doesn't change it in a database that already exists.
# 127.0.0.1 for npm run dev. Docker Compose sets postgres inside the app container.
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Arize Phoenix, where each chat turn's trace goes (systems design section 10). Locally,
# that's the server's Phoenix, through the SSH tunnel in DEVELOPMENT.md section 2:
# http://127.0.0.1:6006, and the road-trip-agent-local project. Docker Compose sets them
# inside the app container, so the server's .env leaves them out.
PHOENIX_URL=
PHOENIX_PROJECT=

# The DigitalOcean Spaces key for the nightly backup (systems design section 9).
# Only the backup service gets them. They can stay empty locally.
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# The site name Caddy serves and gets a certificate for: localhost locally,
# roadtrip.jjk3.com on the server (systems design section 6).
SITE_ADDRESS=

# production on the server, which starts the backup and phoenix services (systems
# design sections 9 and 10). Leave it empty locally.
COMPOSE_PROFILES=

# The code review's GitHub Apps, for posting and pushing as the reviewer or the fixer
# from this machine (systems design section 8). Each key file stays in a folder outside
# the repo. src/code-review/app-token.ts makes a token from them. In CI, the IDs are repo
# variables and the keys' contents are repo secrets, named without _PATH.
REVIEWER_APP_ID=
REVIEWER_APP_PRIVATE_KEY_PATH=
FIXER_APP_ID=
FIXER_APP_PRIVATE_KEY_PATH=
