{
  "permissions": {
    "allow": [
      "Bash(ssh root@projects.jjk3.com:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)"
    ],
    "ask": [
      "Edit(/tsconfig*.json)",
      "Edit(/web/tsconfig.json)",
      "Edit(/eslint.config.*)",
      "Edit(/.prettierrc.json)",
      "Edit(/.prettierignore)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/lefthook.yml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edited-file.sh"
          }
        ]
      }
    ]
  }
}
