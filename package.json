{
  "name": "road-trip-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.24.10",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-barrel-files": "2.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@anthropic-ai/sdk": "0.135.0",
    "@arizeai/openinference-instrumentation-claude-agent-sdk": "0.3.5",
    "@arizeai/phoenix-client": "7.16.2",
    "@arizeai/phoenix-otel": "2.3.0",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@photostructure/tz-lookup": "11.7.0",
    "@supabase/supabase-js": "2.117.2",
    "@types/react": "19.3.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "lefthook@2.2.2": true
  },
  "scripts": {
    "dev": "concurrently --names app,web --kill-others \"npm:dev:app\" \"npm:dev:web\"",
    "dev:app": "tsx watch --env-file=.env src/main.ts",
    "dev:web": "vite",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "ask-claude": "tsx --env-file=.env src/ask-claude.ts",
    "chat": "tsx --env-file=.env src/chat.ts",
    "eval:memory": "tsx --env-file=.env src/evals/user-or-trip-memory.ts",
    "eval:rejudge": "tsx --env-file=.env src/evals/rejudge.ts",
    "build": "npm run build:app && npm run build:web",
    "build:app": "esbuild src/main.ts src/migrate.ts src/ask-claude.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outdir=dist/app",
    "build:web": "vite build",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write src web",
    "format:check": "prettier --check src web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --update=none",
    "agent-views": "vitest run --update=all src/agent/agent-views.test.ts"
  }
}
